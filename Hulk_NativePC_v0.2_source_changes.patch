+// Non-invasive instrumentation for the PM4 candidates recovered from the user's
+// recompilation binary. These are NOT yet confirmed D3D entry-point identities.
+// Enable only in a developer build: -DHULK_XDK_PM4_PROBE=ON
+// Original functions ALWAYS run; this does not implement Vulkan drawing.
+#include <atomic>
+#include <rex/hook.h>
+#include <rex/logging.h>
+
+#define HULK_PM4_PROBE(address)                                 \
+  REX_EXTERN(__imp__sub_##address);                             \
+  REX_HOOK_RAW(sub_##address) {                                 \
+    static std::atomic<uint32_t> calls{0};                      \
+    uint32_t n = calls.fetch_add(1, std::memory_order_relaxed); \
+    if (n < 24) {                                               \
+      REXLOG_INFO("[Hulk PM4 probe] 0x" #address                 \
+                  " sample {} r3={:08X} r4={:08X} r5={:08X}", \
+                  n, ctx.r3.u32, ctx.r4.u32, ctx.r5.u32);        \
+    }                                                          \
+    __imp__sub_##address(ctx, base);                            \
+  }
+
+// Strong candidate builders, not assumed to be specific XDK Draw* APIs.
+HULK_PM4_PROBE(8289D888)
+HULK_PM4_PROBE(8289F720)
+HULK_PM4_PROBE(8289D730)
+HULK_PM4_PROBE(8289F5C8)
+HULK_PM4_PROBE(8289A1F8)
